# Server-side only (never VITE_-prefixed, so never in the client bundle).
# Copy to .env.local for `npm run dev`; set the same names in Netlify → Site settings → Environment variables.

# Scoring proxy + moderation (Qwen via Alibaba Cloud DashScope / Model Studio).
# Without it: mock scores, word-list moderation.
DASHSCOPE_API_KEY=
# Optional. Default is the international endpoint; for a mainland China key use
# https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=
# Optional. Default qwen3-vl-plus (qwen3-vl-flash is cheaper but not enabled for our key).
# QWEN_MODEL=

# Shared wall storage. Without them: each browser keeps its own wall in localStorage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 이어 그리기 rooms (supabase/relay.sql). Server only: it bypasses row-level security.
# Without it: rooms live in the dev server's memory (fine for `npm run dev`, NOT for Netlify).
SUPABASE_SERVICE_ROLE_KEY=

# MOCK=1 forces mock mode locally even when the keys above are set.
# MOCK=1
